---
import NavMenu from './NavMenu.tsx';

const navItems = [
    { linkText: 'Get Involved', href: '/get-involved' },
    { linkText: 'About Us', href: '/about' },
    { linkText: 'Contact', href: '/contact' },
];

const pathname = Astro.url.pathname;
---

<header class="bg-cream/95 backdrop-blur-sm sticky top-0 z-50 border-b border-parchment">
    <div class="max-w-5xl mx-auto px-6 sm:px-12 flex items-center justify-between h-16 sm:h-20">
        <a href="/" class="flex items-center gap-2.5 no-underline hover:opacity-90 transition-opacity" aria-label="Hello by Hand home">
            <img src="/images/logo.svg" alt="Hello by Hand" class="h-10 sm:h-12 w-auto" />
        </a>

        <nav class="hidden md:flex items-center gap-6">
            {navItems.map((item) => (
                <a
                    href={item.href}
                    class:list={[
                        'text-sm font-medium no-underline transition-colors px-1 py-0.5',
                        pathname === item.href || pathname.startsWith(item.href + '/')
                            ? 'text-brand-blue'
                            : 'text-ink-light hover:text-brand-blue'
                    ]}
                >
                    {item.linkText}
                </a>
            ))}
            <a href="/book" class="btn ml-2">Host a Meetup</a>
        </nav>

        <NavMenu client:load items={navItems} />
    </div>
</header>

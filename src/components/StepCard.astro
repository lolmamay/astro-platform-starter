---
interface Props {
    number: number;
    title: string;
    description: string;
    icon?: string;
}

const { number, title, description, icon } = Astro.props;
---

<div class="bg-white rounded-2xl p-8 shadow-sm border border-parchment text-center">
    <div class="w-12 h-12 rounded-full bg-brand-blue/10 text-brand-blue font-display text-xl font-bold flex items-center justify-center mx-auto mb-5">
        {icon ?? number}
    </div>
    <h3 class="font-display text-xl text-ink mb-2">{title}</h3>
    <p class="text-ink-muted text-sm leading-relaxed">{description}</p>
</div>
